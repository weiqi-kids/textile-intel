{"id": "unknown-2026-05-19-008", "date": "2026-05-19", "time_tags": {"year": 2026, "quarter": "Q2", "month": 5, "week": 21, "weekday": "Tue"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift"], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.5, "reasons": []}, "title": "Indian ministry mulls integrating eri silk with Rajasthan’s Kota doria", "content": "India’s Ministry of Development of North Eastern Region is mulling over the possibility of integrating eri silk with Kota doria fabric of Rajasthan state to develop a premium handloom fabric for domestic and global markets. \nThe initiative is expected to be formalised through an MoU between the North Eastern Handicrafts and Handlooms Development Corporation and Rajasthan’s District Industries Centre.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/indian-ministry-mulls-integrating-eri-silk-with-rajasthan-s-kota-doria-310399-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-05-19-009", "date": "2026-05-19", "time_tags": {"year": 2026, "quarter": "Q2", "month": 5, "week": 21, "weekday": "Tue"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["cotton_price"], "sentiment": {"label": "negative", "score": -0.75, "keywords": ["loss", "weak"]}, "importance": {"score": 0.65, "reasons": ["情緒極端"]}, "title": "ICE cotton rebounds sharply on hopes of improving US-China ties", "content": "ICE cotton futures rebounded sharply after last week’s steep losses, supported by bullish macro sentiment, a weaker US dollar, stronger grain markets and hopes of improving US-China agricultural trade relations.\nJuly futures gained 3.83 per cent, recovering nearly half of recent losses, while aggressive short-covering and positive commodity sentiment boosted buying interest.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/ice-cotton-rebounds-sharply-on-hopes-of-improving-us-china-ties-310397-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-05-19-010", "date": "2026-05-19", "time_tags": {"year": 2026, "quarter": "Q2", "month": 5, "week": 21, "weekday": "Tue"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["cotton_price", "supply_chain_shift"], "sentiment": {"label": "negative", "score": -0.67, "keywords": ["loss", "weak", "uncertainty"]}, "importance": {"score": 0.5, "reasons": []}, "title": "North India cotton yarn shows mixed trend amid cautious demand", "content": "North India’s cotton yarn market showed a mixed trend, with Ludhiana prices rising due to stronger export demand and higher mill selling rates, while Delhi remained steady amid cautious buying.\nPanipat recycled yarn prices were unchanged as weak home textile demand and geopolitical uncertainty curbed export orders, while cotton prices paused after recent ICE cotton losses.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/north-india-cotton-yarn-shows-mixed-trend-amid-cautious-demand-310392-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-05-19-011", "date": "2026-05-19", "time_tags": {"year": 2026, "quarter": "Q2", "month": 5, "week": 21, "weekday": "Tue"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift"], "sentiment": {"label": "negative", "score": -0.5, "keywords": ["[否定]growth"]}, "importance": {"score": 0.5, "reasons": []}, "title": "Cambodia’s apparel exports rise 9.6% in January-April 2026", "content": "Cambodia’s apparel exports rose 9.61 per cent to $3.45 billion in January–April 2026, accounting for 31.1 per cent of total exports and reaffirming the sector’s importance to the economy.\nStrong April growth and gains across knitted and woven apparel reflected resilient sourcing demand, while rising cotton imports signalled changing raw-material preferences among manufacturers.", "sources": [{"name": "fibre2fashion_apparel", "url": "https://www.fibre2fashion.com/news/apparel-news/cambodia-s-apparel-exports-rise-9-6-in-january-april-2026-310394-newsdetails.htm", "type": "rss"}]}
