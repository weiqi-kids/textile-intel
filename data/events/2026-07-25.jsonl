{"id": "unknown-2026-07-25-010", "date": "2026-07-25", "time_tags": {"year": 2026, "quarter": "Q3", "month": 7, "week": 30, "weekday": "Sat"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift"], "sentiment": {"label": "negative", "score": -0.6, "keywords": ["decline", "concerns", "slow", "weak", "pressure"]}, "importance": {"score": 0.5, "reasons": []}, "title": "EU slowdown deepens Bangladesh apparel industry concerns", "content": "Bangladesh’s apparel exports to the EU reportedly fell 18.89 per cent year-on-year in January-May 2026, the steepest drop among major suppliers.\nThe fall outpaced declines for China, India and Vietnam, signalling pressure beyond weak demand and lower prices.\nExporters face urgency to reduce reliance on the EU and US and move into higher-value and technical products.", "sources": [{"name": "fibre2fashion_apparel", "url": "https://www.fibre2fashion.com/news/apparel-news/eu-slowdown-deepens-bangladesh-apparel-industry-concerns-312052-newsdetails.htm", "type": "rss"}]}
