{"id": "unknown-2026-09-14-005", "date": "2026-09-14", "time_tags": {"year": 2026, "quarter": "Q3", "month": 9, "week": 38, "weekday": "Mon"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift", "earnings"], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.75, "reasons": ["涉及財報"]}, "title": "Indian Railways loads 137.9 mn tonnes of freight in August", "content": "Indian Railways’ freight loading rose 5.4 per cent YoY to 137.9 million tonnes in August 2026, with freight revenue up 6.27 per cent. \nHigher domestic container and bulk commodity movement points to greater rail use for industrial inputs and finished goods across regions. \nFive new Gati Shakti Cargo Terminals took the network to 149, improving rail access near production and consumption centres. ", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/indian-railways-loads-137-9-mn-tonnes-of-freight-in-august-313457-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-09-14-006", "date": "2026-09-14", "time_tags": {"year": 2026, "quarter": "Q3", "month": 9, "week": 38, "weekday": "Mon"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift"], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.5, "reasons": []}, "title": "Bangladesh pauses 10-30 count yarn bond facility withdrawal", "content": "Bangladesh has paused its move to end bonded, zero-duty imports of 10-30 count cotton yarn and replace them with bank guarantees. \nThe review matters to knitwear exporters because this yarn range dominates annual use and feeds fabric production. \nBGMEA, BKMEA and BTMA are expected to discuss a sourcing framework with the Commerce Ministry soon. ", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/bangladesh-pauses-10-30-count-yarn-bond-facility-withdrawal-313451-newsdetails.htm", "type": "rss"}]}
{"id": "adidas-2026-09-14-007", "date": "2026-09-14", "time_tags": {"year": 2026, "quarter": "Q3", "month": 9, "week": 38, "weekday": "Mon"}, "entities": {"companies": ["adidas", "inditex"], "customers": [], "suppliers": []}, "topics": [], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.7, "reasons": ["多公司提及"]}, "title": "TikTok and fashion: How brands turn trends into sales", "content": "Social platforms can create global demand in days, forcing apparel brands to turn digital trends into products before they peak.\nAdidas Samba, Havaianas, UGG, Princess Polly and Zara show how social-media signals, product strategy and responsiveness can capture demand.\nThe emerging model is Detect, Test, Measure and Replenish, making supply-chain speed and flexibility critical.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/tiktok-and-fashion-how-brands-turn-trends-into-sales-313452-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-09-14-008", "date": "2026-09-14", "time_tags": {"year": 2026, "quarter": "Q3", "month": 9, "week": 38, "weekday": "Mon"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift"], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.5, "reasons": []}, "title": "India's WPI rises to 9.92%, textile inflation at 12.63%", "content": "India's all-commodity WPI inflation rose to 9.92 per cent YoY in August 2026 from 9.78 per cent in July, with the index at 110.8.\nManufacture of textiles inflation eased to 12.63 per cent from 12.80 per cent, while apparel stood at 3.12 per cent.\nFuel, food products, basic metals, non-food articles and chemicals were key price drivers, affecting sourcing cost visibility.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/india-s-wpi-rises-to-9-92-textile-inflation-at-12-63--313453-newsdetails.htm", "type": "rss"}]}
