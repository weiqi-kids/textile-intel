{"id": "adidas-2026-09-14-007", "date": "2026-09-14", "time_tags": {"year": 2026, "quarter": "Q3", "month": 9, "week": 38, "weekday": "Mon"}, "entities": {"companies": ["adidas", "inditex"], "customers": [], "suppliers": []}, "topics": [], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.7, "reasons": ["多公司提及"]}, "title": "TikTok and fashion: How brands turn trends into sales", "content": "Social platforms can create global demand in days, forcing apparel brands to turn digital trends into products before they peak.\nAdidas Samba, Havaianas, UGG, Princess Polly and Zara show how social-media signals, product strategy and responsiveness can capture demand.\nThe emerging model is Detect, Test, Measure and Replenish, making supply-chain speed and flexibility critical.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/tiktok-and-fashion-how-brands-turn-trends-into-sales-313452-newsdetails.htm", "type": "rss"}]}
