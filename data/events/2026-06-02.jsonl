{"id": "unknown-2026-06-02-010", "date": "2026-06-02", "time_tags": {"year": 2026, "quarter": "Q2", "month": 6, "week": 23, "weekday": "Tue"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift"], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.5, "reasons": []}, "title": "India’s PDS earns great place to work recognition across 10 nations", "content": "PDS has been recognised as a Great Place to Work across 10 countries, including India, UK, China and Turkiye, reflecting its focus on trust, inclusion and employee wellbeing.\nBased on direct employee feedback with nearly 90 per cent participation, the certification highlights strong workforce engagement.\nThe group continues investing in leadership, collaboration and inclusive workplace practices globally.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/india-s-pds-earns-great-place-to-work-recognition-across-10-nations-310720-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-06-02-011", "date": "2026-06-02", "time_tags": {"year": 2026, "quarter": "Q2", "month": 6, "week": 23, "weekday": "Tue"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift"], "sentiment": {"label": "negative", "score": -0.25, "keywords": ["growth", "decline"]}, "importance": {"score": 0.5, "reasons": []}, "title": "Driven by 6.2% manufacturing growth, India’s April IIP grows 4.9% YoY", "content": "The growth rate in India’s index of industrial production (IIP) for April was 4.9 per cent YoY, while the IIP was 118.9. \nThe manufacturing growth rate in the month was 6.2 per cent YoY, while the IIP for the same was 119.3. \nThe IIP for textile manufacturing was 132.6, while its growth rate was 15.6 per cent YoY. \nThe IIP for apparel manufacturing was 91.6, while its growth declined by 7 per cent YoY. ", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/driven-by-6-2-manufacturing-growth-india-s-april-iip-grows-4-9-yoy-310711-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-06-02-012", "date": "2026-06-02", "time_tags": {"year": 2026, "quarter": "Q2", "month": 6, "week": 23, "weekday": "Tue"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift"], "sentiment": {"label": "neutral", "score": 0.17, "keywords": ["increase", "strong demand", "weak"]}, "importance": {"score": 0.5, "reasons": []}, "title": "Strong Asian demand lifts US Upland cotton exports: USDA", "content": "US Upland cotton sales rose 17 per cent week on week to 153,600 RB in the week ended May 21, while shipments increased 10 per cent to 317,700 RB, supported by strong demand from Vietnam, Pakistan, China and Türkiye.\nIn contrast, Pima cotton demand weakened sharply, with sales and exports declining significantly despite continued purchases from India.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/strong-asian-demand-lifts-us-upland-cotton-exports-usda-310712-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-06-02-013", "date": "2026-06-02", "time_tags": {"year": 2026, "quarter": "Q2", "month": 6, "week": 23, "weekday": "Tue"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift"], "sentiment": {"label": "positive", "score": 0.5, "keywords": ["improve"]}, "importance": {"score": 0.5, "reasons": []}, "title": "India’s cotton duty waiver signals strategic export push: NITMA", "content": "NITMA has welcomed India’s temporary suspension of the 11 per cent cotton import duty, calling it a strategic move to improve export competitiveness rather than merely a short-term relief measure.\nThe association said lower input costs will strengthen the textile value chain, support supply chain stability, enhance export opportunities and help the industry compete effectively in global markets.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/india-s-cotton-duty-waiver-signals-strategic-export-push-nitma-310710-newsdetails.htm", "type": "rss"}]}
