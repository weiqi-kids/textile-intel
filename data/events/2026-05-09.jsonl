{"id": "unknown-2026-05-09-006", "date": "2026-05-09", "time_tags": {"year": 2026, "quarter": "Q2", "month": 5, "week": 19, "weekday": "Sat"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["cotton_price", "supply_chain_shift"], "sentiment": {"label": "neutral", "score": 0.0, "keywords": ["increase", "slow"]}, "importance": {"score": 0.5, "reasons": []}, "title": "South India cotton yarn sees sharp rise despite slow local demand", "content": "India’s cotton yarn market witnessed another sharp rise this week, supported by strong export demand, higher cotton prices, and aggressive mill pricing despite sluggish domestic buying.\nYarn prices increased sharply in Tiruppur and Mumbai, while Gujarat cotton prices surged further due to higher CCI auction rates and firm ICE cotton prices.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/south-india-cotton-yarn-sees-sharp-rise-despite-slow-local-demand-310200-newsdetails.htm", "type": "rss"}]}
