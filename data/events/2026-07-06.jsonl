{"id": "unknown-2026-07-06-006", "date": "2026-07-06", "time_tags": {"year": 2026, "quarter": "Q3", "month": 7, "week": 28, "weekday": "Mon"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["fast_fashion", "sustainable_textile"], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.5, "reasons": []}, "title": "Is fast fashion finally dying in Europe? A deep dive into 2026 shifts", "content": "Europe is reshaping the fast fashion industry through stricter regulations, higher compliance costs and greater producer responsibility for textile waste.\nMeasures targeting ultra-low-cost imports, unsold clothing and recycling are accelerating the shift towards circular fashion.\nThe sector is adapting rather than disappearing, with sustainability becoming a stronger competitive factor.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/is-fast-fashion-finally-dying-in-europe-a-deep-dive-into-2026-shifts-311492-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-07-06-007", "date": "2026-07-06", "time_tags": {"year": 2026, "quarter": "Q3", "month": 7, "week": 28, "weekday": "Mon"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift"], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.5, "reasons": []}, "title": "India’s Tamil Nadu textile sector seeks clean energy policy support", "content": "Tamil Nadu's textile industry has urged the state government to support renewable energy adoption through reforms such as annual wind power banking, solar power adjustments, and open-access incentives.\nThe sector says lower power costs are vital to improving competitiveness, while the government has assured consideration of the proposals.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/india-s-tamil-nadu-textile-sector-seeks-clean-energy-policy-support-311485-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-07-06-008", "date": "2026-07-06", "time_tags": {"year": 2026, "quarter": "Q3", "month": 7, "week": 28, "weekday": "Mon"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["cotton_price", "supply_chain_shift"], "sentiment": {"label": "negative", "score": -0.83, "keywords": ["loss", "decline", "weak"]}, "importance": {"score": 0.65, "reasons": ["情緒極端"]}, "title": "Indian polyester feedstock extends decline; China rebounds", "content": "Indian polyester raw material and fibre prices extended their decline as lower crude oil pushed down purified terephthalic acid, melt, polyester staple fibre, and acrylic prices, while viscose staple fibre, modal and Excel fibre gained on firmer demand.\nChina's polyester feedstock market recovered after early-week losses, though weak textile demand continued to limit polyester price recovery.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/indian-polyester-feedstock-extends-decline-china-rebounds-311484-newsdetails.htm", "type": "rss"}]}
