{"id": "unknown-2026-10-17-004", "date": "2026-10-17", "time_tags": {"year": 2026, "quarter": "Q4", "month": 10, "week": 42, "weekday": "Sat"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift"], "sentiment": {"label": "negative", "score": -0.5, "keywords": ["uncertainty"]}, "importance": {"score": 0.5, "reasons": []}, "title": "Russian diesel deal and questions over US trade policy consistency", "content": "Trump’s diesel arrangement with Russia has raised questions over US energy policy and trade measures, adding uncertainty for Indian textile and apparel exporters.\nIndia shipped about $9.68 billion of textile and apparel products to the US in 2025, nearly 30 per cent of its sector exports.\nPiyush Goyal said the first tranche of an India-US trade deal is finalised and under legal scrutiny.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/russian-diesel-deal-and-questions-over-us-trade-policy-consistency-314342-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-10-17-005", "date": "2026-10-17", "time_tags": {"year": 2026, "quarter": "Q4", "month": 10, "week": 42, "weekday": "Sat"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift"], "sentiment": {"label": "positive", "score": 0.5, "keywords": ["growth", "[否定]weak"]}, "importance": {"score": 0.5, "reasons": []}, "title": "IMF raises Asia-Pacific growth forecast to 4.8% for 2026", "content": "IMF has raised its Asia-Pacific growth forecast to 4.8 per cent this year and 4.4 per cent next year, citing resilience amid energy shocks, tariffs and supply-chain disruption.  \nAsia will provide two-thirds of global growth, with upgrades for India, Korea and parts of Southeast Asia; risks include high oil prices, weaker low-income and Pacific island economies, debt yields and AI-led job shifts. ", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/imf-raises-asia-pacific-growth-forecast-to-4-8-for-2026-314325-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-10-17-006", "date": "2026-10-17", "time_tags": {"year": 2026, "quarter": "Q4", "month": 10, "week": 42, "weekday": "Sat"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift"], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.5, "reasons": []}, "title": "Vietnam extends PFY duties through 2031: Will sourcing patterns shift?", "content": "Vietnam has extended anti-dumping duties on polyester filament yarn imports from China, India, Indonesia and Malaysia until October 15, 2031.\nThe measure covers POY, DTY and FDY under six HS subheadings, with rates of 54.90 per cent for India, 21.94 per cent for Indonesia and 21.45 per cent for Malaysia.\nChinese company-specific rates range from 3.36 to 17.45 per cent.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/vietnam-extends-pfy-duties-through-2031-will-sourcing-patterns-shift--314335-newsdetails.htm", "type": "rss"}]}
