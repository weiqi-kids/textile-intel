{"id": "unknown-2026-05-06-005", "date": "2026-05-06", "time_tags": {"year": 2026, "quarter": "Q2", "month": 5, "week": 19, "weekday": "Wed"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["cotton_price", "supply_chain_shift"], "sentiment": {"label": "positive", "score": 0.5, "keywords": ["improve"]}, "importance": {"score": 0.5, "reasons": []}, "title": "India approves $595 mn cotton mission as supply tightens", "content": "India approved a $595 million cotton productivity mission for 2026-31 to boost yields, quality and self-sufficiency amid rising cotton and yarn prices, tight domestic supply, and higher exports.\nThe plan focuses on better seeds, modern farming, traceability and processing, targeting higher output, improved productivity, and stronger global competitiveness.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/india-approves-595-mn-cotton-mission-as-supply-tightens-310127-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-05-06-006", "date": "2026-05-06", "time_tags": {"year": 2026, "quarter": "Q2", "month": 5, "week": 19, "weekday": "Wed"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["cotton_price"], "sentiment": {"label": "positive", "score": 0.5, "keywords": ["improve"]}, "importance": {"score": 0.5, "reasons": []}, "title": "ICE cotton extends rally on dry weather, crude oil surge", "content": "ICE cotton futures surged to fresh multi-month highs as dry weather in West Texas, elevated crude oil prices and supportive macroeconomic sentiment boosted buying interest.\nRising polyester costs improved cotton’s competitiveness against man-made fibres, while geopolitical risks and expectations of renewed Chinese participation continued to support overall market sentiment.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/ice-cotton-extends-rally-on-dry-weather-crude-oil-surge-310126-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-05-06-007", "date": "2026-05-06", "time_tags": {"year": 2026, "quarter": "Q2", "month": 5, "week": 19, "weekday": "Wed"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift"], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.5, "reasons": []}, "title": "US sanctions hit Turkish textile trade, trigger compliance risk surge", "content": "OFAC’s April 21 strike on Esenyurt’s Emti Fiber Textile, a 30-month-old cotton-linter trader feeding Iran's missile chain, has rewritten Turkish textile compliance overnight. \nTurkiye’s $26.18 billion sector fell 4.4 per cent in 2025 as EU buyers shifted to China (+22.3%), Bangladesh (+17.9%), Vietnam (+17.3%); Turkiye alone slipped 5.8 per cent. \nBrand vendor purges hit May 5-12.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/us-sanctions-hit-turkish-textile-trade-trigger-compliance-risk-surge-310122-newsdetails.htm", "type": "rss"}]}
