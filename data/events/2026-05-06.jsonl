{"id": "unknown-2026-05-06-009", "date": "2026-05-06", "time_tags": {"year": 2026, "quarter": "Q2", "month": 5, "week": 19, "weekday": "Wed"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift"], "sentiment": {"label": "positive", "score": 0.5, "keywords": ["growth", "[否定]pressure"]}, "importance": {"score": 0.5, "reasons": []}, "title": "Cambodia cuts 2026 growth forecast to 4.2% amid Middle East turmoil", "content": "Cambodia has lowered its 2026 growth forecast to 4.2 per cent from 5 per cent due to rising oil and gas prices amid Middle East instability and Thailand border tensions.\nInflationary pressures are weighing on the economy, though growth is expected to recover to 5 per cent in 2027. \nExport-driven sectors and tourism remain vulnerable to global volatility.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/cambodia-cuts-2026-growth-forecast-to-4-2-amid-middle-east-turmoil-310104-newsdetails.htm", "type": "rss"}]}
