{"id": "unknown-2026-09-03-001", "date": "2026-09-03", "time_tags": {"year": 2026, "quarter": "Q3", "month": 9, "week": 36, "weekday": "Thu"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift"], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.5, "reasons": []}, "title": "Can India sustain its 19.7% China yarn share as disruptions fade?", "content": "India’s cotton-yarn shipments to China rose roughly fivefold from November 2025 to about 1,500 containers, or 30,000 tonnes, a month.\nIts share of China’s cotton-yarn imports reached 19.71 per cent in January–February 2026, overtaking Pakistan.\nThe share slipped to 17.71 per cent in April, behind Vietnam’s about 44 per cent, suggesting the surge may have peaked.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/can-india-sustain-its-19-7-china-yarn-share-as-disruptions-fade--313198-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-09-03-002", "date": "2026-09-03", "time_tags": {"year": 2026, "quarter": "Q3", "month": 9, "week": 36, "weekday": "Thu"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift"], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.5, "reasons": []}, "title": "India targets wider FTA use to boost exports across 780 districts", "content": "India has called for a nationwide FTA utilisation drive to turn trade agreements into export gains for MSMEs and first-time exporters. \nIt will cover all 780 districts, targeting traders, startups and women entrepreneurs. \nMinister of Commerce and Industry Piyush Goyal said nine FTAs span economies representing about $60 trillion in GDP and offer preferential access to nearly two-thirds of global trade.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/india-targets-wider-fta-use-to-boost-exports-across-780-districts-313197-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-09-03-003", "date": "2026-09-03", "time_tags": {"year": 2026, "quarter": "Q3", "month": 9, "week": 36, "weekday": "Thu"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["earnings"], "sentiment": {"label": "neutral", "score": 0.0, "keywords": ["improve", "uncertainty"]}, "importance": {"score": 0.75, "reasons": ["涉及財報"]}, "title": "US economic activity grows modestly as manufacturing picks up", "content": "US economic activity grew modestly since early July, with 10 of 12 Fed Districts reporting slight to moderate expansion, as per the August Beige Book. \nConsumer spending rose slightly but remained price-sensitive, while manufacturing activity improved across most regions. \nEmployment rose marginally, labour demand stayed strongest in manufacturing, and outlook remained positive despite uncertainty.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/us-economic-activity-grows-modestly-as-manufacturing-picks-up-313187-newsdetails.htm", "type": "rss"}]}
