{"id": "unknown-2026-05-08-012", "date": "2026-05-08", "time_tags": {"year": 2026, "quarter": "Q2", "month": 5, "week": 19, "weekday": "Fri"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["earnings"], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.75, "reasons": ["涉及財報"]}, "title": "The next textile boom won’t look like apparel", "content": "Textile profitability is shifting from commodity apparel towards technical, performance and smart fabrics. \nBuyers increasingly value certified durability, protection and performance over fashion-led differentiation alone. \nSuppliers able to deliver verifiable quality, regulatory alignment and scalable innovation are positioned to capture stronger margins and longer-term demand.", "sources": [{"name": "fibre2fashion_apparel", "url": "https://www.fibre2fashion.com/news/apparel-news/the-next-textile-boom-won-t-look-like-apparel-310180-newsdetails.htm", "type": "rss"}]}
