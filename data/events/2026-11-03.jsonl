{"id": "unknown-2026-11-03-011", "date": "2026-11-03", "time_tags": {"year": 2026, "quarter": "Q4", "month": 11, "week": 45, "weekday": "Tue"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift"], "sentiment": {"label": "positive", "score": 0.67, "keywords": ["record", "growth", "increase"]}, "importance": {"score": 0.5, "reasons": []}, "title": "India targets $1 trn in exports after record $863 bn last year: Goyal", "content": "India's exports rose 14 per cent year on year to $480 billion in April-September, putting the country on track towards its $1 trillion annual target, which requires another $520 billion in the second half. \nIndia's Commerce Minister Piyush Goyal said the IMF had revised its global trade growth forecast to around 3.5 per cent, with India's export performance potentially contributing to the increase.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/india-targets-1-trn-in-exports-after-record-863-bn-last-year-goyal-314767-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-11-03-012", "date": "2026-11-03", "time_tags": {"year": 2026, "quarter": "Q4", "month": 11, "week": 45, "weekday": "Tue"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["cotton_price", "order_visibility", "supply_chain_shift", "earnings"], "sentiment": {"label": "negative", "score": -0.5, "keywords": ["slow", "weak"]}, "importance": {"score": 0.75, "reasons": ["涉及財報"]}, "title": "South Indian cotton yarn prices ease amid weak demand, duty relief", "content": "South Indian cotton yarn weakened after duty-free cotton imports were extended until December, with Mumbai prices down ₹2–3 (~$0.02–0.03) per kg amid weak demand, tight liquidity and profit-booking.\nTiruppur stayed steady as mills rolled over November rates but offered discounts to attract buyers ahead of Diwali.\nGujarat cotton fell ₹1,500–1,800 per candy as mill demand slowed and new-crop arrivals rose.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/south-indian-cotton-yarn-prices-ease-amid-weak-demand-duty-relief-314764-newsdetails.htm", "type": "rss"}]}
{"id": "lenzing-2026-11-03-013", "date": "2026-11-03", "time_tags": {"year": 2026, "quarter": "Q4", "month": 11, "week": 45, "weekday": "Tue"}, "entities": {"companies": ["lenzing", "toray"], "customers": [], "suppliers": []}, "topics": ["order_visibility"], "sentiment": {"label": "negative", "score": -1.0, "keywords": ["[否定]leading"]}, "importance": {"score": 0.85, "reasons": ["多公司提及", "情緒極端"]}, "title": "Techtextil and Texprocess 2028 strengthen textile value-chain links", "content": "Techtextil and Texprocess will return to Frankfurt on 4–7 April 2028 with an optimised hall layout linking materials, production technologies and processing.\nLeading exhibitors have already registered, including Lenzing, Toray Textiles Europe, Kornit and Veit.\nThe concurrent fairs aim to strengthen value-chain collaboration, with early-booking rates available until 30 November 2026.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/techtextil-and-texprocess-2028-strengthen-textile-value-chain-links-314758-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-11-03-014", "date": "2026-11-03", "time_tags": {"year": 2026, "quarter": "Q4", "month": 11, "week": 45, "weekday": "Tue"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift"], "sentiment": {"label": "neutral", "score": 0.0, "keywords": ["growth", "weak"]}, "importance": {"score": 0.5, "reasons": []}, "title": "India's manufacturing PMI eases to 54.7 in October: S&P Global", "content": "India’s manufacturing PMI fell to 54.7 in October from 55.1 in September but stayed above the 50.0 neutral mark and its long-run average.\nNew export orders grew at the fastest rate in six months, supporting output even as overall new business and production growth softened.\nInput cost inflation fell to its lowest since February, while hiring rose only slightly and confidence weakened.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/india-s-manufacturing-pmi-eases-to-54-7-in-october-s-p-global-314744-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-11-03-015", "date": "2026-11-03", "time_tags": {"year": 2026, "quarter": "Q4", "month": 11, "week": 45, "weekday": "Tue"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift"], "sentiment": {"label": "negative", "score": -0.75, "keywords": ["decline", "weak"]}, "importance": {"score": 0.65, "reasons": ["情緒極端"]}, "title": "600 fewer units, $1 bn down. India’s apparel crisis exposed", "content": "US apparel imports from India fell 25.96 per cent to $2.891 billion in January–August 2026, far outpacing the overall US market's 7.02 per cent contraction.\nIndia's share slipped to 5.59 per cent, with $740 million of the decline tied to lost share, TexPro analysis shows.\nNoida industry estimates point to 600 fewer operating units and weaker exports.", "sources": [{"name": "fibre2fashion_apparel", "url": "https://www.fibre2fashion.com/news/apparel-news/600-fewer-units-1-bn-down-india-s-apparel-crisis-exposed-314762-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-11-03-016", "date": "2026-11-03", "time_tags": {"year": 2026, "quarter": "Q4", "month": 11, "week": 45, "weekday": "Tue"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift"], "sentiment": {"label": "negative", "score": -0.25, "keywords": ["increase", "decline"]}, "importance": {"score": 0.5, "reasons": []}, "title": "Bangladesh's exports rise 6% to $17.04 bn in Jul-Oct, led by RMG", "content": "Bangladesh's merchandise exports rose nearly 6.0 per cent year on year to $17.04 billion in July-October of FY27, led by readymade garments, Bangladesh Bank data showed.\nKnitwear exports grew 7.0 per cent to $7.71 billion, while woven garments rose 4.80 per cent to $6.0 billion.\nJute goods, leather goods, home textiles and footwear also increased, but cotton products declined 10.2 per cent.", "sources": [{"name": "fibre2fashion_apparel", "url": "https://www.fibre2fashion.com/news/apparel-news/bangladesh-s-exports-rise-6-to-17-04-bn-in-jul-oct-led-by-rmg-314749-newsdetails.htm", "type": "rss"}]}
