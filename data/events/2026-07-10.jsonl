{"id": "unknown-2026-07-10-010", "date": "2026-07-10", "time_tags": {"year": 2026, "quarter": "Q3", "month": 7, "week": 28, "weekday": "Fri"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift"], "sentiment": {"label": "positive", "score": 0.33, "keywords": ["[否定]decline", "concerns", "[否定]weak"]}, "importance": {"score": 0.5, "reasons": []}, "title": "US T&A imports drop to $39 bn in Jan-May; Vietnam retains top spot", "content": "US textile and apparel imports fell 8.92 per cent to $39.13 billion in January-May 2026, according to the Office of Textiles and Apparel (OTEXA).\nVietnam remained the top supplier, while China's shipments declined sharply.\nApparel and non-apparel imports both weakened, reflecting shifting sourcing towards Southeast Asia amid tariff concerns and changing supply chain strategies.", "sources": [{"name": "fibre2fashion_apparel", "url": "https://www.fibre2fashion.com/news/apparel-news/us-t-a-imports-drop-to-39-bn-in-jan-may-vietnam-retains-top-spot-311557-newsdetails.htm", "type": "rss"}]}
