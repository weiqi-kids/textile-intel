{"id": "unknown-2026-07-10-006", "date": "2026-07-10", "time_tags": {"year": 2026, "quarter": "Q3", "month": 7, "week": 28, "weekday": "Fri"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift"], "sentiment": {"label": "negative", "score": -0.25, "keywords": ["increase", "decline"]}, "importance": {"score": 0.5, "reasons": []}, "title": "US cotton export sales recover but remain below four-week average", "content": "US Upland cotton export sales rose 36 per cent to 66,400 running bales (RB) in the week ended July 2, led by Vietnam and India, while shipments increased 5 per cent to 230,100 RB.\nNew-crop sales also strengthened.\nPima cotton sales rebounded, but export shipments declined sharply from the previous week's seasonal peak despite stronger buying interest.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/us-cotton-export-sales-recover-but-remain-below-four-week-average-311640-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-07-10-007", "date": "2026-07-10", "time_tags": {"year": 2026, "quarter": "Q3", "month": 7, "week": 28, "weekday": "Fri"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["cotton_price", "order_visibility", "earnings"], "sentiment": {"label": "negative", "score": -0.5, "keywords": ["concerns", "weak", "pressure"]}, "importance": {"score": 0.75, "reasons": ["涉及財報"]}, "title": "ICE cotton weakens as profit booking, lower crude weigh on prices", "content": "ICE cotton futures fell for a second straight session as profit-taking and lower crude oil prices outweighed weather concerns and export demand.\nThe December 2026 contract settled at 80.63 cents/lb.\nTraders stayed cautious ahead of the USDA's July WASDE report, while weaker US export sales and lower trading volumes added to market pressure.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/ice-cotton-weakens-as-profit-booking-lower-crude-weigh-on-prices-311635-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-07-10-008", "date": "2026-07-10", "time_tags": {"year": 2026, "quarter": "Q3", "month": 7, "week": 28, "weekday": "Fri"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift"], "sentiment": {"label": "positive", "score": 1.0, "keywords": ["record"]}, "importance": {"score": 0.65, "reasons": ["情緒極端"]}, "title": "Brazil's cotton export boom is redrawing Asian trade", "content": "Brazil shipped a record 217,000 tonnes in June (+63 per cent YoY); 96.3 per cent of Brazil-origin cotton flowed to Asian markets.\nTurkey's imports rose 64.4 per cent year on year (YoY), while Bangladesh became June's top buyer (21.7 per cent), confirming a sourcing shift.\nThe buyer edge may narrow as Brazil's crop falls, global stocks drop to 71.1 million bales, and the US intensifies exports.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/brazil-s-cotton-export-boom-is-redrawing-asian-trade-311626-newsdetails.htm", "type": "rss"}]}
