{"id": "unknown-2026-06-18-008", "date": "2026-06-18", "time_tags": {"year": 2026, "quarter": "Q2", "month": 6, "week": 25, "weekday": "Thu"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["cotton_price"], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.5, "reasons": []}, "title": "ICE cotton extends rally for fifth day on strong December buying", "content": "ICE cotton futures rose for a fifth consecutive session, driven by speculative buying, short covering, and strong call-option activity.\nThe benchmark December 2026 contract settled at 79.79 cents per pound, close to the key 80-cent level.\nRising open interest, robust options trading and firm deferred spreads reflected growing confidence in higher cotton prices.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/ice-cotton-extends-rally-for-fifth-day-on-strong-december-buying-311078-newsdetails.htm", "type": "rss"}]}
