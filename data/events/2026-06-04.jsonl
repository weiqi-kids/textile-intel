{"id": "unknown-2026-06-04-015", "date": "2026-06-04", "time_tags": {"year": 2026, "quarter": "Q2", "month": 6, "week": 23, "weekday": "Thu"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift", "earnings"], "sentiment": {"label": "negative", "score": -0.5, "keywords": ["[否定]growth", "pressure"]}, "importance": {"score": 0.75, "reasons": ["涉及財報"]}, "title": "Bangladesh's power tariff hike to hit textile-apparel sector hard", "content": "The latest electricity price hike in Bangladesh will likely put a lot of pressure on major sectors listed on the stock market and may hit inflation, corporate profitability and overall economic growth.\nSectors like textiles and garments that are heavily dependent on electricity may face the biggest impact. \nListed textile-garment firms could face additional challenges in maintaining global competitiveness. ", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/bangladesh-s-power-tariff-hike-to-hit-textile-apparel-sector-hard-310774-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-06-04-016", "date": "2026-06-04", "time_tags": {"year": 2026, "quarter": "Q2", "month": 6, "week": 23, "weekday": "Thu"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["cotton_price", "supply_chain_shift", "earnings"], "sentiment": {"label": "positive", "score": 0.5, "keywords": ["improve"]}, "importance": {"score": 0.75, "reasons": ["涉及財報"]}, "title": "ICE cotton eases on stronger US dollar, improved rainfall outlook", "content": "ICE cotton futures eased in a narrow trading range as a stronger US dollar reduced the competitiveness of US exports and improved weather conditions boosted crop prospects.\nThe July 2026 contract settled at 76.73 cents per pound.\nMarket sentiment remained cautious as favourable US supply expectations and rising certified stocks offset support from India’s temporary cotton import duty waiver.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/ice-cotton-eases-on-stronger-us-dollar-improved-rainfall-outlook-310770-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-06-04-017", "date": "2026-06-04", "time_tags": {"year": 2026, "quarter": "Q2", "month": 6, "week": 23, "weekday": "Thu"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift"], "sentiment": {"label": "neutral", "score": 0.0, "keywords": ["improve", "slow"]}, "importance": {"score": 0.5, "reasons": []}, "title": "US-Bangladesh textile pact: Zero tariffs vs supply chain realities", "content": "A new US-Bangladesh trade agreement could allow certain Bangladeshi apparel exports to enter the US at zero tariff if they use US-origin cotton and textile inputs.\nWhile the move may improve competitiveness and boost US cotton imports, industry experts caution that longer shipping times, higher costs, and reliance on regional supply chains could slow a shift away from current suppliers.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/us-bangladesh-textile-pact-zero-tariffs-vs-supply-chain-realities-310765-newsdetails.htm", "type": "rss"}]}
