{"id": "unknown-2026-06-17-005", "date": "2026-06-17", "time_tags": {"year": 2026, "quarter": "Q2", "month": 6, "week": 25, "weekday": "Wed"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift"], "sentiment": {"label": "positive", "score": 0.5, "keywords": ["growth"]}, "importance": {"score": 0.5, "reasons": []}, "title": "Impressive growth of Vietnam’s merchandise foreign trade in Jan-May", "content": "Vietnam’s merchandise foreign trade saw impressive growth in January-May 2026, with total turnover rising by 25 per cent YoY to over $445 billion. \nExports generated $215.66 billion—up by 19.5 per cent YoY, while imports rose by 30.8 per cent YoY to $229.46 billion. \nIn May, foreign trade turnover exceeded $99 billion for the first time. \nThe country targets export growth of 15-16 per cent YoY this year. ", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/impressive-growth-of-vietnam-s-merchandise-foreign-trade-in-jan-may-311049-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-06-17-006", "date": "2026-06-17", "time_tags": {"year": 2026, "quarter": "Q2", "month": 6, "week": 25, "weekday": "Wed"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift"], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.5, "reasons": []}, "title": "India reimposes hank yarn obligation to support handloom sector", "content": "India has reinstated a mandatory hank yarn packing requirement, directing cotton yarn producers to allocate 20 per cent of quarterly output in hank form for domestic use from July 2026 to June 2029.\nThe move aims to ensure adequate yarn supply for the handloom sector, ease shortages, support traditional weaving livelihoods, and stabilise availability.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/india-reimposes-hank-yarn-obligation-to-support-handloom-sector-311048-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-06-17-007", "date": "2026-06-17", "time_tags": {"year": 2026, "quarter": "Q2", "month": 6, "week": 25, "weekday": "Wed"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["sustainable_textile"], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.5, "reasons": []}, "title": "HS Codes are blocking circular fashion trade", "content": "Circular fashion is increasingly constrained by outdated customs codes that fail to distinguish reusable clothing, recycling feedstock and waste.\nAs EU sorting rules and Basel scrutiny tighten, clearer HS classifications are becoming essential for traceability, investment and policy enforcement.\nWithout better trade definitions, scaling textile reuse and recycling will remain difficult.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/hs-codes-are-blocking-circular-fashion-trade-311044-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-06-17-008", "date": "2026-06-17", "time_tags": {"year": 2026, "quarter": "Q2", "month": 6, "week": 25, "weekday": "Wed"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["cotton_price"], "sentiment": {"label": "neutral", "score": -0.17, "keywords": ["strong demand", "concerns", "weak"]}, "importance": {"score": 0.5, "reasons": []}, "title": "ICE cotton extends rally for fourth session on short covering", "content": "ICE cotton futures rose for a fourth straight session, driven by short covering, technical buying, and a weaker US dollar.\nWeather concerns across key US cotton-growing regions also supported prices.\nHowever, declining open interest and below-average trading volumes suggest the rally remains cautious and liquidation-driven rather than backed by strong demand fundamentals.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/ice-cotton-extends-rally-for-fourth-session-on-short-covering-311046-newsdetails.htm", "type": "rss"}]}
