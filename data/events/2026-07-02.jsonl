{"id": "unknown-2026-07-02-003", "date": "2026-07-02", "time_tags": {"year": 2026, "quarter": "Q3", "month": 7, "week": 27, "weekday": "Thu"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["cotton_price", "supply_chain_shift"], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.5, "reasons": []}, "title": "India extends zero customs duty on PTA, MEG till July 15", "content": "India has extended the zero customs duty on PTA and MEG imports until July 15, 2026, providing temporary relief to polyester producers amid West Asia-related supply disruptions.\nThe move is expected to ease raw material costs, though downstream polyester prices may take longer to normalise due to high-cost inventories and uneven pass-through.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/india-extends-zero-customs-duty-on-pta-meg-till-july-15-311405-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-07-02-004", "date": "2026-07-02", "time_tags": {"year": 2026, "quarter": "Q3", "month": 7, "week": 27, "weekday": "Thu"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift"], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.5, "reasons": []}, "title": "India’s technical textile exports triple in a decade", "content": "India’s technical textile exports have more than tripled over the past decade to ₹28,392 crore in FY25, driven by government support and rising Sportech demand, Minister Pabitra Margherita said.\nAt the Sportech Bharat Vision 2047 conference, industry urged duty and GST reforms, while officials highlighted NTTM’s focus on commercialisation and innovation.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/india-s-technical-textile-exports-triple-in-a-decade-311402-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-07-02-005", "date": "2026-07-02", "time_tags": {"year": 2026, "quarter": "Q3", "month": 7, "week": 27, "weekday": "Thu"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift"], "sentiment": {"label": "negative", "score": -0.75, "keywords": ["decline", "weak"]}, "importance": {"score": 0.65, "reasons": ["情緒極端"]}, "title": "Italian textile machinery eyes revival through innovation", "content": "Italy's textile machinery production fell 9 per cent and exports declined 8 per cent in 2025 amid weak global demand, but India emerged as the largest export market with sales rising 28 per cent to €176 million. \nACIMIT said innovation, sustainability, digitalisation and talent development will be central to strengthening competitiveness ahead of ITMA 2027.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/italian-textile-machinery-eyes-revival-through-innovation-311399-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-07-02-006", "date": "2026-07-02", "time_tags": {"year": 2026, "quarter": "Q3", "month": 7, "week": 27, "weekday": "Thu"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["cotton_price"], "sentiment": {"label": "negative", "score": -0.5, "keywords": ["weak"]}, "importance": {"score": 0.5, "reasons": []}, "title": "ICE cotton continues to rise on third day, supported by gains", "content": "ICE cotton futures rose for a third straight session, with the December 2026 contract settling at 77.84 cents, supported by gains in Chicago grain markets.\nHowever, larger-than-expected US cotton acreage and weaker crude oil prices limited the rally.\nTraders now await the US Department of Agriculture’s weekly export sales report for fresh demand signals.", "sources": [{"name": "fibre2fashion_textile", "url": "https://www.fibre2fashion.com/news/textile-news/ice-cotton-continues-to-rise-on-third-day-supported-by-gains-311400-newsdetails.htm", "type": "rss"}]}
{"id": "unknown-2026-07-02-007", "date": "2026-07-02", "time_tags": {"year": 2026, "quarter": "Q3", "month": 7, "week": 27, "weekday": "Thu"}, "entities": {"companies": [], "customers": [], "suppliers": []}, "topics": ["supply_chain_shift", "earnings"], "sentiment": {"label": "neutral", "score": 0.0, "keywords": []}, "importance": {"score": 0.75, "reasons": ["涉及財報"]}, "title": "Italian-Irish venture to set up footwear factory in Bangladesh", "content": "Italian and Irish-backed Deltaport Footwear will invest $21.6 million to set up a footwear factory at the Bangladesh Export Processing Zones Authority Economic Zone in Mirsharai, Chattogram.\nThe unit will have an annual production capacity of around 3 million pairs.\nThe factory is expected to create 468 jobs and generate annual export earnings of about $37.5 million.", "sources": [{"name": "fibre2fashion_apparel", "url": "https://www.fibre2fashion.com/news/apparel-news/italian-irish-venture-to-set-up-footwear-factory-in-bangladesh-311392-newsdetails.htm", "type": "rss"}]}
